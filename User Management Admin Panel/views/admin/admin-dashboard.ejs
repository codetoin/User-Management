<%- include("../partials/header.ejs") %>

<div class="d-flex flex-column flex-lg-row min-vh-100 p-4">

  <!-- Sidebar -->
  <nav
    class="bg-body shadow-sm border rounded-3 p-4 me-4 flex-shrink-0"
    style="min-width: 240px; height: fit-content;"
  >
    <h5 class="fw-bold mb-4 text-center text-danger">Admin Panel</h5>

    <div class="d-grid gap-3">
      <a
        href="/admin/dashboard"
        class="btn btn-outline-secondary d-flex align-items-center justify-content-start fw-semibold rounded-3 shadow-sm"
      >
        <i class="bi bi-speedometer2 me-2"></i> Dashboard
      </a>

      <a
        href="/admin/users"
        class="btn btn-outline-primary d-flex align-items-center justify-content-start fw-semibold rounded-3 shadow-sm"
      >
        <i class="bi bi-people me-2"></i> Manage Users
      </a>

      <a
        href="/admin/settings"
        class="btn btn-outline-warning d-flex align-items-center justify-content-start fw-semibold rounded-3 shadow-sm"
      >
        <i class="bi bi-gear me-2"></i> Admin Settings
      </a>

      <a
        href="/log-out"
        class="btn btn-outline-danger d-flex align-items-center justify-content-start fw-semibold rounded-3 shadow-sm mt-3"
      >
        <i class="bi bi-box-arrow-right me-2"></i> Logout
      </a>
    </div>
  </nav>

  <!-- Main Content -->
  <div class="flex-grow-1">
    <h1 class="mb-3">Admin Dashboard</h1>

    <p class="text-muted">
      Welcome, <strong><%= admin.user_name %></strong> 👋
    </p>

    <!-- System Overview -->
    <div class="card shadow-sm border-0 rounded-3 p-4 mt-4">
      <h4 class="mb-3">System Overview</h4>

      <div class="row g-3">
        <div class="col-md-3">
          <div class="border rounded-3 p-3 text-center bg-body">
            <h5 class="mb-1"><%= stats.total_users %></h5>
            <small class="text-muted">Total Users</small>
          </div>
        </div>

        <div class="col-md-3">
          <div class="border rounded-3 p-3 text-center bg-success-subtle">
            <h5 class="mb-1"><%= stats.active_users %></h5>
            <small class="text-muted">Active Users</small>
          </div>
        </div>

        <div class="col-md-3">
          <div class="border rounded-3 p-3 text-center bg-warning-subtle">
            <h5 class="mb-1"><%= stats.inactive_users %></h5>
            <small class="text-muted">Inactive Users</small>
          </div>
        </div>

        <div class="col-md-3">
          <div class="border rounded-3 p-3 text-center bg-danger-subtle">
            <h5 class="mb-1"><%= stats.admin_count %></h5>
            <small class="text-muted">Admins</small>
          </div>
        </div>
      </div>
    </div>
  </div>

</div>


<%- include("../partials/footer.ejs") %>