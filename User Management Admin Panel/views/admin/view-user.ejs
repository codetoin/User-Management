<%- include("../partials/header.ejs") %>
<div class="d-flex flex-column flex-lg-row min-vh-100 p-4">

  <!-- Admin Sidebar -->
  <nav
    class="bg-body shadow-sm border rounded-3 p-4 me-4 flex-shrink-0"
    style="min-width: 240px; height: fit-content;"
  >
    <h5 class="fw-bold mb-4 text-center text-danger">Admin Panel</h5>

    <div class="d-grid gap-3">
      <a href="/admin/dashboard"
         class="btn btn-outline-secondary d-flex align-items-center justify-content-start fw-semibold rounded-3 shadow-sm">
        <i class="bi bi-speedometer2 me-2"></i> Dashboard
      </a>

      <a href="/admin/users"
         class="btn btn-outline-primary d-flex align-items-center justify-content-start fw-semibold rounded-3 shadow-sm">
        <i class="bi bi-people me-2"></i> Users
      </a>

      <a href="/admin/settings"
         class="btn btn-outline-warning d-flex align-items-center justify-content-start fw-semibold rounded-3 shadow-sm">
        <i class="bi bi-gear me-2"></i> Admin Settings
      </a>

      <a href="/log-out"
         class="btn btn-outline-danger d-flex align-items-center justify-content-start fw-semibold rounded-3 shadow-sm mt-3">
        <i class="bi bi-box-arrow-right me-2"></i> Logout
      </a>
    </div>
  </nav>

  <!-- Main Content -->
  <div class="flex-grow-1">

    <h2 class="mb-4">View User</h2>

    <!-- User Info -->
    <div class="card shadow-sm border-0 rounded-3 p-4 mb-4">
      <h4 class="mb-3">User Information</h4>

      <p><strong>Name:</strong> <%= user.user_name %></p>
      <p><strong>Email:</strong> <%= user.email %></p>
      <p><strong>Role:</strong>
        <span class="badge bg-secondary ms-2"><%= user.role %></span>
      </p>

      <p>
        <strong>Status:</strong>
        <% if (user.is_active) { %>
          <span class="badge bg-success ms-2">Active</span>
        <% } else { %>
          <span class="badge bg-danger ms-2">Inactive</span>
        <% } %>
      </p>

      <p>
        <strong>Member since:</strong>
        <%= new Date(user.created_at).toLocaleString() %>
      </p>

      <p>
        <strong>Updated At:</strong>
        <%= user.updated_at
          ? new Date(user.updated_at).toLocaleString()
          : "Never" %>
      </p>
    </div>

    <!-- Admin Actions -->
    <div class="card shadow-sm border-0 rounded-3 p-4">
      <h4 class="mb-3 text-danger">Admin Actions</h4>

      <div class="d-flex flex-wrap gap-2">

        <form method="get" action="/admin/users/<%= user.id %>/edit">
          <button type="submit" class="btn btn-primary">
            <i class="bi bi-pencil-square me-1"></i> Edit User
          </button>
        </form>

        <% if (admin.id !== user.id) { %>

          <% if (user.is_active) { %>
            <form method="POST" action="/admin/users/<%= user.id %>/deactivate">
              <button type="submit" class="btn btn-warning">
                <i class="bi bi-slash-circle me-1"></i> Deactivate
              </button>
            </form>
          <% } else { %>
            <form method="POST" action="/admin/users/<%= user.id %>/activate">
              <button type="submit" class="btn btn-success">
                <i class="bi bi-check-circle me-1"></i> Activate
              </button>
            </form>
          <% } %>

          <form
            method="POST"
            action="/admin/users/<%= user.id %>/delete"
            onsubmit="return confirm('Are you sure you want to delete this user?')"
          >
            <button type="submit" class="btn btn-danger">
              <i class="bi bi-trash me-1"></i> Delete
            </button>
          </form>

        <% } else { %>
          <span class="badge bg-info fs-6 align-self-center">
            This is you
          </span>
        <% } %>
      </div>

      <hr class="my-4">

      <form method="get" action="/view-user/back">
        <button type="submit" class="btn btn-outline-secondary">
          <i class="bi bi-arrow-left me-1"></i> Back
        </button>
      </form>

    </div>

  </div>
</div>

<%- include("../partials/footer.ejs") %>
