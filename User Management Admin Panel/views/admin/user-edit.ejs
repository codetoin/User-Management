<%- include("../partials/header.ejs") %>


<div class="d-flex flex-column flex-lg-row min-vh-100 p-4">

  <!-- Admin Sidebar -->
  <nav
    class="bg-body shadow-sm border rounded-3 p-4 me-4 flex-shrink-0"
    style="min-width: 240px; height: fit-content;"
  >
    <h5 class="fw-bold mb-4 text-center text-danger">Admin Panel</h5>

    <div class="d-grid gap-3">
      <a href="/admin/dashboard"
         class="btn btn-outline-secondary d-flex align-items-center justify-content-start fw-semibold rounded-3 shadow-sm">
        <i class="bi bi-speedometer2 me-2"></i> Dashboard
      </a>

      <a href="/admin/users"
         class="btn btn-outline-primary d-flex align-items-center justify-content-start fw-semibold rounded-3 shadow-sm">
        <i class="bi bi-people me-2"></i> Users
      </a>

      <a href="/admin/settings"
         class="btn btn-outline-warning d-flex align-items-center justify-content-start fw-semibold rounded-3 shadow-sm">
        <i class="bi bi-gear me-2"></i> Admin Settings
      </a>

      <a href="/log-out"
         class="btn btn-outline-danger d-flex align-items-center justify-content-start fw-semibold rounded-3 shadow-sm mt-3">
        <i class="bi bi-box-arrow-right me-2"></i> Logout
      </a>
    </div>
  </nav>

  <!-- Main Content -->
  <div class="flex-grow-1">

    <h2 class="mb-4">Edit User</h2>

    <div class="card shadow-sm border-0 rounded-3 p-4">
      <form method="POST" action="/admin/users/<%= user.id %>/edit">

        <!-- Name -->
        <div class="mb-3">
          <label class="form-label fw-semibold">Name</label>
          <input
            type="text"
            name="name"
            class="form-control"
            value="<%= user.user_name %>"
            required
          />
        </div>

        <!-- Email -->
        <div class="mb-3">
          <label class="form-label fw-semibold">Email</label>
          <input
            type="email"
            name="email"
            class="form-control"
            value="<%= user.email %>"
            readonly
          />
          <small class="text-muted">Email cannot be changed</small>
        </div>

        <!-- Role -->
        <div class="mb-3">
          <label class="form-label fw-semibold">Role</label>
          <select name="role" class="form-select">
            <option value="user"  <%= user.role === "user" ? "selected" : "" %>>
              User
            </option>
            <option value="admin" <%= user.role === "admin" ? "selected" : "" %>>
              Admin
            </option>
          </select>
        </div>

        <!-- Status -->
        <div class="mb-4">
          <label class="form-label fw-semibold">Status</label>
          <select name="status" class="form-select">
            <option value="active"   <%= user.is_active ? "selected" : "" %>>
              Active
            </option>
            <option value="inactive" <%= !user.is_active ? "selected" : "" %>>
              Inactive
            </option>
          </select>
        </div>

        <!-- Actions -->
        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-circle me-1"></i> Save Changes
          </button>

          <a href="/admin/users/<%= user.id %>" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Cancel
          </a>
        </div>

      </form>
    </div>

  </div>
</div>




<%- include("../partials/footer.ejs") %>