<%- include("../partials/header.ejs") %>
<div class="d-flex flex-column flex-lg-row min-vh-100 p-4">

  <!-- Admin Sidebar -->
  <nav
    class="bg-body shadow-sm border rounded-3 p-4 me-4 flex-shrink-0"
    style="min-width: 240px; height: fit-content;"
  >
    <h5 class="fw-bold mb-4 text-center text-danger">Admin Panel</h5>

    <div class="d-grid gap-3">
      <a href="/admin/dashboard"
         class="btn btn-outline-secondary d-flex align-items-center justify-content-start fw-semibold rounded-3 shadow-sm">
        <i class="bi bi-speedometer2 me-2"></i> Dashboard
      </a>

      <a href="/admin/users"
         class="btn btn-outline-primary d-flex align-items-center justify-content-start fw-semibold rounded-3 shadow-sm">
        <i class="bi bi-people me-2"></i> Users
      </a>

      <a href="/admin/settings"
         class="btn btn-outline-warning d-flex align-items-center justify-content-start fw-semibold rounded-3 shadow-sm">
        <i class="bi bi-gear me-2"></i> Admin Settings
      </a>

      <a href="/log-out"
         class="btn btn-outline-danger d-flex align-items-center justify-content-start fw-semibold rounded-3 shadow-sm mt-3">
        <i class="bi bi-box-arrow-right me-2"></i> Logout
      </a>
    </div>
  </nav>

  <!-- Main Content -->
  <div class="flex-grow-1">
    <h1 class="mb-3">Admin → Users</h1>

    <p class="text-muted mb-4">
      Logged in as <strong><%= admin.user_name %></strong>
    </p>

    <!-- Search -->
    <form method="GET" action="/admin/users" class="mb-4">
      <div class="input-group">
        <input
          type="text"
          name="search"
          class="form-control"
          placeholder="Search by name or email"
          value="<%= search || '' %>"
        />
        <button class="btn btn-primary">
          <i class="bi bi-search"></i> Search
        </button>
      </div>
    </form>

    <!-- Users Table -->
    <div class="card shadow-sm border-0 rounded-3">
      <div class="card-body p-0">

        <% if (users.length === 0) { %>
          <p class="p-4 mb-0 text-muted">No users found.</p>
        <% } else { %>

        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>#</th>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Status</th>
                <th>Created</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>

            <tbody>
              <% users.forEach((user, index) => { %>
              <tr>
                <td><%= index + 1 %></td>
                <td><%= user.user_name %></td>
                <td><%= user.email %></td>
                <td>
                  <span class="badge bg-secondary">
                    <%= user.role %>
                  </span>
                </td>
                <td>
                  <% if (user.is_active) { %>
                    <span class="badge bg-success">Active</span>
                  <% } else { %>
                    <span class="badge bg-warning text-dark">Inactive</span>
                  <% } %>
                </td>
                <td><%= new Date(user.created_at).toLocaleDateString() %></td>
                <td class="text-end">

                  <a href="/admin/users/<%= user.id %>"
                     class="btn btn-sm btn-outline-primary me-1">
                    View
                  </a>

                  <% if (user.is_active) { %>
                    <form method="POST"
                          action="/admin/users/<%= user.id %>/deactivate"
                          class="d-inline">
                      <button class="btn btn-sm btn-outline-warning">
                        Deactivate
                      </button>
                    </form>
                  <% } else { %>
                    <form method="POST"
                          action="/admin/users/<%= user.id %>/activate"
                          class="d-inline">
                      <button class="btn btn-sm btn-outline-success">
                        Activate
                      </button>
                    </form>
                  <% } %>

                  <% if (admin.id !== user.id) { %>
                    <form method="POST"
                          action="/admin/users/<%= user.id %>/delete"
                          class="d-inline"
                          onsubmit="return confirm('Are you sure you want to delete this user?')">
                      <button class="btn btn-sm btn-outline-danger">
                        Delete
                      </button>
                    </form>
                  <% } else { %>
                    <span class="badge bg-info fs-6 px-3 py-2">You</span>
                  <% } %>

                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <% } %>
      </div>
    </div>

  </div>
</div>

<%- include("../partials/footer.ejs") %>
