<%- include("../partials/header.ejs") %>

<div class="d-flex flex-column flex-lg-row min-vh-100 p-4">

  <!-- Admin Sidebar -->
  <nav
    class="bg-body shadow-sm border rounded-3 p-4 me-4 flex-shrink-0"
    style="min-width: 240px; height: fit-content;"
  >
    <h5 class="fw-bold mb-4 text-center text-danger">Admin Panel</h5>

    <div class="d-grid gap-3">
      <a href="/admin/dashboard"
         class="btn btn-outline-secondary d-flex align-items-center justify-content-start fw-semibold rounded-3 shadow-sm">
        <i class="bi bi-speedometer2 me-2"></i> Dashboard
      </a>

      <a href="/admin/users"
         class="btn btn-outline-primary d-flex align-items-center justify-content-start fw-semibold rounded-3 shadow-sm">
        <i class="bi bi-people me-2"></i> Users
      </a>

      <a href="/admin/settings"
         class="btn btn-outline-warning d-flex align-items-center justify-content-start fw-semibold rounded-3 shadow-sm">
        <i class="bi bi-gear me-2"></i> Admin Settings
      </a>

      <a href="/log-out"
         class="btn btn-outline-danger d-flex align-items-center justify-content-start fw-semibold rounded-3 shadow-sm mt-3">
        <i class="bi bi-box-arrow-right me-2"></i> Logout
      </a>
    </div>
  </nav>

  <!-- Main Content -->
  <div class="flex-grow-1">

    <h1 class="mb-4">Update Admin Profile</h1>

    <!-- Update Profile Form -->
    <div class="card shadow-sm border-0 rounded-3 p-4 mb-4">
      <h4 class="mb-3">Profile Information</h4>

      <form action="/admin-update-profile" method="POST">

        <div class="mb-3">
          <label class="form-label fw-semibold">Username</label>
          <input
            type="text"
            name="user_name"
            class="form-control"
            value="<%= user.user_name %>"
            required
          >
        </div>

        <div class="mb-4">
          <label class="form-label fw-semibold">Email (Read Only)</label>
          <input
            type="email"
            name="email"
            class="form-control"
            value="<%= user.email %>"
            readonly
          >
        </div>

        <hr class="my-4">

        <h5 class="mb-3">Change Password</h5>

        <div class="mb-3">
          <label class="form-label">Current Password</label>
          <input type="password" name="currentPassword" class="form-control">
        </div>

        <div class="mb-3">
          <label class="form-label">New Password</label>
          <input type="password" name="newPassword" class="form-control">
        </div>

        <div class="mb-4">
          <label class="form-label">Confirm New Password</label>
          <input type="password" name="confirmPassword" class="form-control">
        </div>

        <button type="submit" class="btn btn-primary rounded-3 shadow-sm">
          <i class="bi bi-save me-2"></i> Update Profile
        </button>

        <a href="/admin/settings" class="btn btn-outline-secondary ms-2 rounded-3">
          Cancel
        </a>
      </form>
    </div>

    <!-- Account Info -->
    <div class="card shadow-sm border-0 rounded-3 p-4">
      <h4 class="mb-3">Account Info</h4>

      <p><strong>Role:</strong> <%= user.role %></p>
      <p>
        <strong>Status:</strong>
        <% if (user.is_active) { %>
          <span class="badge bg-success">Active</span>
        <% } else { %>
          <span class="badge bg-danger">Disabled</span>
        <% } %>
      </p>
      <p><strong>Created At:</strong> <%= new Date(user.created_at).toLocaleString() %></p>
    </div>

  </div>
</div>


<%- include("../partials/footer.ejs") %>