<%- include("../partials/header.ejs") %>
<div class="d-flex flex-column flex-lg-row min-vh-100 p-4">

  <!-- Sidebar: Quick Actions -->
  <nav
    class="bg-body shadow-sm border rounded-3 p-4 me-4 flex-shrink-0"
    style="min-width: 240px; height: fit-content"
  >
    <h5 class="fw-bold mb-4 text-center text-primary">Quick Actions</h5>

    <div class="d-grid gap-3">
      <a href="/user-home" class="btn btn-outline-secondary d-flex align-items-center justify-content-start fw-semibold rounded-3 shadow-sm">
        <i class="bi bi-house-door me-2"></i> Home
      </a>
      <a href="/user-profile" class="btn btn-outline-primary d-flex align-items-center justify-content-start fw-semibold rounded-3 shadow-sm">
        <i class="bi bi-person-circle me-2"></i> Profile
      </a>
      <a href="/edit-profile" class="btn btn-outline-success d-flex align-items-center justify-content-start fw-semibold rounded-3 shadow-sm">
        <i class="bi bi-pencil-square me-2"></i> Edit Profile
      </a>
      <a href="/settings" class="btn btn-outline-warning d-flex align-items-center justify-content-start fw-semibold rounded-3 shadow-sm">
        <i class="bi bi-gear me-2"></i> Settings
      </a>
      <a href="/change-password" class="btn btn-outline-info d-flex align-items-center justify-content-start fw-semibold rounded-3 shadow-sm">
        <i class="bi bi-key me-2"></i> Change Password
      </a>
      <a href="/log-out" class="btn btn-outline-danger d-flex align-items-center justify-content-start fw-semibold rounded-3 shadow-sm mt-3">
        <i class="bi bi-box-arrow-right me-2"></i> Logout
      </a>
    </div>
  </nav>

  <!-- Main Content -->
  <div class="flex-grow-1">
    <h1 class="mb-4">Settings</h1>

    <div class="card shadow-sm border-0 rounded-3 p-4 mb-4">
      <!-- Account Info -->
      <h3>Account Information</h3>
      <p><strong>Name:</strong> <%= user.user_name %></p>
      <p><strong>Email:</strong> <%= user.email %></p>
      <p><strong>Role:</strong> <%= user.role %></p>
      <p><strong>Active:</strong> <%= user.is_active ? "Yes" : "No" %></p>
      <p>
        <strong>Member since:</strong>
        <%= new Date(user.created_at).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" }) %>
      </p>
      <a href="/edit-profile" class="btn btn-outline-success btn-sm rounded-3 mt-2">
        <i class="bi bi-pencil-square me-2"></i> Edit Profile
      </a>
    </div>

    <div class="card shadow-sm border-0 rounded-3 p-4 mb-4">
      <!-- Security -->
      <h3>Security</h3>
      <a href="/change-password" class="btn btn-outline-info btn-sm rounded-3 mt-2">
        <i class="bi bi-key me-2"></i> Change Password
      </a>
    </div>

    <div class="card shadow-sm border-0 rounded-3 p-4 mb-4">
      <!-- Preferences -->
      <h3>Preferences</h3>
      <form action="/settings/preferences" method="POST">
        <label for="theme" class="form-label fw-semibold">Theme:</label>
        <select name="theme" id="themeSelect" class="form-select mb-3">
          <option value="light">Light</option>
          <option value="dark">Dark</option>
        </select>
        <button type="submit" class="btn btn-primary btn-sm rounded-3">
          <i class="bi bi-check-lg me-2"></i> Save Preferences
        </button>
      </form>
    </div>

    <div class="card shadow-sm border-0 rounded-3 p-4 mb-4">
      <!-- Danger Zone -->
      <h3 class="text-danger">Danger Zone</h3>
      <form action="/diactivate" method="POST" class="mb-2">
        <button type="submit" class="btn btn-warning btn-sm rounded-3">
          <i class="bi bi-exclamation-triangle me-2"></i> Change My Account Status
        </button>
      </form>
      <form action="/delete-account" method="POST" onsubmit="return confirmDelete()">
        <button type="submit" class="btn btn-danger btn-sm rounded-3">
          <i class="bi bi-trash me-2"></i> Delete My Account
        </button>
      </form>
    </div>
  </div>

</div>

<script>
  function confirmDelete() {
    return confirm(
      "Are you sure you want to delete this account? This action cannot be undone."
    );
  }
</script>
<%- include("../partials/footer.ejs") %>
