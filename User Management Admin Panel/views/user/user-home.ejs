<%- include("../partials/header.ejs") %>

<div class="d-flex flex-column flex-lg-row">
  <!-- Sidebar: Quick Actions -->
  <nav
    class="bg-body shadow-sm border rounded-3 p-4 me-4 flex-shrink-0"
    style="min-width: 240px; height: fit-content"
  >
    <h5 class="fw-bold mb-4 text-center text-primary">Quick Actions</h5>

    <div class="d-grid gap-3">
      <a
        href="/user-home"
        class="btn btn-outline-secondary d-flex align-items-center justify-content-start fw-semibold rounded-3 shadow-sm"
      >
        <i class="bi bi-person-circle me-2"></i> Home
      </a>
      <a
        href="/user-profile"
        class="btn btn-outline-primary d-flex align-items-center justify-content-start fw-semibold rounded-3 shadow-sm"
      >
        <i class="bi bi-person-circle me-2"></i> Profile
      </a>
      <a
        href="/edit-profile"
        class="btn btn-outline-success d-flex align-items-center justify-content-start fw-semibold rounded-3 shadow-sm"
      >
        <i class="bi bi-pencil-square me-2"></i> Edit Profile
      </a>
      <a
        href="/settings"
        class="btn btn-outline-warning d-flex align-items-center justify-content-start fw-semibold rounded-3 shadow-sm"
      >
        <i class="bi bi-gear me-2"></i> Settings
      </a>
      <a
        href="/change-password"
        class="btn btn-outline-info d-flex align-items-center justify-content-start fw-semibold rounded-3 shadow-sm"
      >
        <i class="bi bi-key me-2"></i> Change Password
      </a>
      <a
        href="/log-out"
        class="btn btn-outline-danger d-flex align-items-center justify-content-start fw-semibold rounded-3 shadow-sm mt-3"
      >
        <i class="bi bi-box-arrow-right me-2"></i> Logout
      </a>
    </div>
  </nav>

  <!-- Page content stays untouched -->
  <div class="flex-grow-1">
    <h2 class="mb-4">Welcome, <%= user.user_name %> 👋</h2>

    <div class="card shadow-sm border-0 mt-4 p-4 rounded-3">
      <h4 class="mb-3">Account Summary</h4>
      <p><strong>Email:</strong> <%= user.email %></p>
      <p><strong>Role:</strong> <%= user.role %></p>
      <p>
        <strong>Status:</strong> <%= user.is_active ? "Active" : "Inactive" %>
      </p>
    </div>
  </div>
</div>

<%- include("../partials/footer.ejs") %>
